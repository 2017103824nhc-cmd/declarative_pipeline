pipeline {
    agent any

    stages {
        stage('Build') {
            steps {
                echo 'Building the project...'
                // 예: npm install 등 빌드 명령어
            }
        }
        stage('Test') {
            steps {
                echo 'Testing the project...'
                // 예: npm test 등 테스트 명령어
            }
        }
        stage('Deploy') {
            steps {
                echo 'Deploying the project...'
                // 예: 배포 스크립트 실행
            }
        }
    }
}